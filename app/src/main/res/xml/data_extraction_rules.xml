<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <exclude domain="sharedpref" path="secure_secrets.xml" />
        <exclude domain="database" path="wardrobe.db" />
        <exclude domain="file" path="temporary_uploads/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="secure_secrets.xml" />
        <exclude domain="database" path="wardrobe.db" />
        <exclude domain="file" path="temporary_uploads/" />
    </device-transfer>
</data-extraction-rules>
